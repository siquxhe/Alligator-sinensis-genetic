[Unit]
Description=iPHoP database download watcher (hourly poll, then verify/extract/predict)
After=network-online.target mnt-disk2t.mount
Wants=network-online.target
RequiresMountsFor=/mnt/disk2t
StartLimitIntervalSec=0

[Service]
Type=simple
User=wuyanching
Group=wuyanching
ExecStart=/home/wuyanching/biotools/server_watch_iphop.sh
Restart=on-failure
RestartSec=300
Nice=5
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
